# the directory to save files to
# absolute or relative path
data-dir string data-out
# prefix the folders saved
save-prefix string test-central-approach
# Usually want to use the GPS,
# unless you are producing a full response matrix.
# Options: gps, central-generator
generator-type string central-generator

# Required for the CentralEventGenerator
central-generator-config string central-test.msgpack

save-each-cryst-hit-energy bool 0
save-each-cryst-hit-momentum bool 0
save-all-scintillator-positions bool 0
save-sipm-positions bool 0
save-sipm-energies bool 0

# unit = nanosecond
scintillator-time-const double 25
enable-scintillation bool 0

lyso-attenuation-length double 50
specular-sigma-alpha-deg double 2

# World volume parameters (in units of mm, aka native G4 units)
world-x double 1000
world-y double 1000
world-z double 1000

# Whether or not we want to save the track and event ids
# for hits that are made
save-track-identifiers bool 0

# Geometric configurations are set via JSON
# metadata which is passed to DetectorConstruction
